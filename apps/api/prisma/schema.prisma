generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The worker reads/writes the same tables; it gets its own generated copy of this schema.
generator workerClient {
  provider = "prisma-client"
  output   = "../../worker/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum NodeRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

// DRAFT: a test run of an unpublished canvas snapshot. PUBLISHED: runs a WorkflowVersion.
enum WorkflowRunSource {
  DRAFT
  PUBLISHED
}

enum ExecutionLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// The kind of model service a credential connects to. Adding a provider is a normal enum migration.
enum CredentialProvider {
  OPENAI
  DEEPSEEK
  OPENAI_COMPATIBLE
}

enum ModelType {
  CHAT
  EMBEDDING
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum KnowledgeDocumentSourceType {
  TEXT
  FILE
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  passwordHash String

  memberships ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id   String @id @default(cuid())
  name String

  members        ProjectMember[]
  workflows      Workflow[]
  credentials    Credential[]
  knowledgeBases KnowledgeBase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ProjectRole

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  description String?
  // PUBLISHED means "at least one version exists"; the draft can still have unpublished edits.
  status      WorkflowStatus @default(DRAFT)

  // Belongs to exactly one project; set at creation time, never changed.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Mutable working copy edited in the canvas editor. Never executed by published runs.
  draftCanvas   Json?
  // Incremented on every draft save; compared with the latest version's revision to detect
  // unpublished changes, and checked at publish time so only the validated draft is published.
  draftRevision Int   @default(0)

  versions WorkflowVersion[]
  runs     WorkflowRun[]
  apiKeys  WorkflowApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// A key that lets external callers run one workflow's published version. The raw key
// (fm_<prefix>_<secret>) is shown once at creation and never stored: only its SHA-256 hash.
model WorkflowApiKey {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name String

  // Public lookup id embedded in the key, separate from the database id.
  prefix  String @unique
  keyHash String

  // Best effort metadata, not part of authentication.
  lastUsedAt DateTime?
  // Kept instead of deleting so past runs still point to the key that triggered them.
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  runs WorkflowRun[]

  @@index([workflowId])
}

// How FlowMind connects to a model provider. Canvases, versions, runs and logs only ever hold the
// credential id; the provider secret lives here, AES-256-GCM encrypted with the master key from
// CREDENTIAL_ENCRYPTION_KEY (never stored in the database). Unlike WorkflowApiKey it is encrypted,
// not hashed: the worker must recover the plaintext to call the provider.
model Credential {
  id String @id @default(cuid())

  name     String
  provider CredentialProvider
  // Null means the provider's official endpoint; required for OPENAI_COMPATIBLE (checked in the service).
  baseUrl  String?

  // Belongs to exactly one project; set at creation time, never changed.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // base64 ciphertext, 12-byte IV (random per encryption, not secret) and 16-byte GCM auth tag.
  encryptedSecret String
  secretIv        String
  secretAuthTag   String

  // Soft delete: published versions may still reference the id, and should fail with
  // CREDENTIAL_REVOKED rather than a dangling reference.
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models Model[]

  @@index([projectId])
}

// A model callable through one credential. LLM nodes will reference it by id only, so its
// identity (credentialId + modelName) never changes after creation; everything else is metadata.
// Never deleted, only disabled: published versions may still reference the id.
model Model {
  id String @id @default(cuid())

  // Restrict: credentials are only revoked, so a hard delete must not silently take models
  // (and the versions referencing them) along.
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  // Display name for FlowMind users, free to change.
  name      String
  // Exact identifier sent to the provider API ("model": "gpt-4.1-mini"). Immutable.
  modelName String

  type ModelType @default(CHAT)

  // Capability hints for the UI, not used to execute.
  contextWindow       Int?
  supportsTemperature Boolean @default(true)
  // Required for EMBEDDING models and null for CHAT models (validated in ModelService).
  embeddingDimensions Int?

  // false: hidden from new node configuration; versions that already use it keep running.
  enabled Boolean @default(true)

  knowledgeBases KnowledgeBase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Also serves as the credentialId index.
  @@unique([credentialId, modelName])
}

// A project-owned collection of documents. It can be created before an embedding model is chosen;
// ingestion will require one later. Restrict preserves the model identity used by existing chunks.
model KnowledgeBase {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  embeddingModelId String?
  embeddingModel   Model?  @relation(fields: [embeddingModelId], references: [id], onDelete: Restrict)

  name        String
  description String?

  documents KnowledgeDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([embeddingModelId])
}

// Ingestion status belongs to the complete document. A retry can delete and rebuild all chunks
// atomically instead of maintaining an unnecessary state machine for every individual chunk.
model KnowledgeDocument {
  id String @id @default(cuid())

  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  name       String
  sourceType KnowledgeDocumentSourceType
  // TEXT documents keep their original source here in v1; FILE will read from storageKey later.
  sourceText String?
  mimeType   String?

  // FILE documents will point to object storage later. TEXT documents need neither field.
  originalFileName String?
  storageKey       String?

  status       KnowledgeDocumentStatus @default(PENDING)
  errorCode    String?
  errorMessage String?

  chunks KnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([knowledgeBaseId])
  @@index([status])
}

// `embedding` is a pgvector extension type. Prisma manages normal fields while future vector
// writes and similarity search use narrowly scoped raw SQL / TypedSQL.
model KnowledgeChunk {
  id String @id @default(cuid())

  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int
  content    String
  tokenCount Int?
  metadata   Json?

  embedding Unsupported("vector")?

  createdAt DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

// Immutable snapshot created by publishing. No update or delete API: runs must stay reproducible.
model WorkflowVersion {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Per-workflow sequence: 1, 2, 3...
  version Int

  canvas        Json
  // Workflow.draftRevision that was published; versions created before revisions existed have 0.
  draftRevision Int

  createdAt DateTime @default(now())

  runs WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
}

model WorkflowRun {
  id String @id @default(cuid())

  // Kept alongside the version for direct history queries and for runs created before versions.
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Exactly one canvas source per run. Prisma cannot express the XOR, so the services set it and
  // the CHECK constraint "WorkflowRun_source_canvas_check" (raw SQL migration) enforces it:
  //   PUBLISHED: draftSnapshot null; workflowVersionId set by the services
  //   DRAFT:     draftSnapshot set, workflowVersionId null, workflowApiKeyId null
  // PUBLISHED may still have a null version: legacy runs from before versioning, which the worker
  // fails explicitly instead of falling back to the draft. No default: callers must choose.
  source WorkflowRunSource

  workflowVersionId String?
  workflowVersion   WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)

  // The canvas a draft test run executes, frozen at request time (may include unsaved edits).
  draftSnapshot Json?

  // Set only for runs created through the external API; null for editor runs.
  workflowApiKeyId String?
  workflowApiKey   WorkflowApiKey? @relation(fields: [workflowApiKeyId], references: [id], onDelete: SetNull)

  status RunStatus @default(PENDING)

  input  Json?
  output Json?

  errorCode    String?
  errorMessage String?

  startedAt   DateTime?
  finishedAt  DateTime?
  // Refreshed by the worker while RUNNING; a stale value means the worker died mid-run.
  heartbeatAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodeRuns NodeRun[]
  logs     ExecutionLog[]

  @@index([workflowId])
  @@index([workflowVersionId])
  @@index([workflowApiKeyId])
  @@index([status])
  @@index([createdAt])
}

model NodeRun {
  id String @id @default(cuid())

  workflowRunId String
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  nodeId   String
  nodeType String

  status NodeRunStatus @default(PENDING)

  sequence  Int
  iteration Int?
  attempt   Int  @default(1)

  input  Json?
  output Json?

  errorCode    String?
  errorMessage String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs ExecutionLog[]

  @@index([workflowRunId])
  @@index([workflowRunId, sequence])
  @@index([nodeId])
}

// Append-only events of a run. Run-level events (claimed, completed, recovered) have no nodeRunId.
model ExecutionLog {
  id String @id @default(cuid())

  workflowRunId String
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  nodeRunId String?
  nodeRun   NodeRun? @relation(fields: [nodeRunId], references: [id], onDelete: Cascade)

  level    ExecutionLogLevel @default(INFO)
  message  String
  // IDs and codes only, never secrets, prompts or full URLs.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([workflowRunId, createdAt])
  @@index([nodeRunId, createdAt])
}
