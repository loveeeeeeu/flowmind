generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The worker reads/writes the same tables; it gets its own generated copy of this schema.
generator workerClient {
  provider = "prisma-client"
  output   = "../../worker/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum NodeRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)

  canvas Json?

  runs WorkflowRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowRun {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status RunStatus @default(PENDING)

  input  Json?
  output Json?

  errorCode    String?
  errorMessage String?

  startedAt  DateTime?
  finishedAt DateTime?
  // Refreshed by the worker while RUNNING; a stale value means the worker died mid-run.
  heartbeatAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodeRuns NodeRun[]

  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
}

model NodeRun {
  id String @id @default(cuid())

  workflowRunId String
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  nodeId   String
  nodeType String

  status NodeRunStatus @default(PENDING)

  sequence  Int
  iteration Int?
  attempt   Int @default(1)

  input  Json?
  output Json?

  errorCode    String?
  errorMessage String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowRunId])
  @@index([workflowRunId, sequence])
  @@index([nodeId])
}
