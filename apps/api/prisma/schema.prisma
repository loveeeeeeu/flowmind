generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The worker reads/writes the same tables; it gets its own generated copy of this schema.
generator workerClient {
  provider = "prisma-client"
  output   = "../../worker/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum NodeRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

// DRAFT: a test run of an unpublished canvas snapshot. PUBLISHED: runs a WorkflowVersion.
enum WorkflowRunSource {
  DRAFT
  PUBLISHED
}

enum ExecutionLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// The kind of model service a credential connects to. Adding a provider is a normal enum migration.
enum CredentialProvider {
  OPENAI
  DEEPSEEK
  OPENAI_COMPATIBLE
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  description String?
  // PUBLISHED means "at least one version exists"; the draft can still have unpublished edits.
  status      WorkflowStatus @default(DRAFT)

  // Mutable working copy edited in the canvas editor. Never executed by published runs.
  draftCanvas Json?
  // Incremented on every draft save; compared with the latest version's revision to detect
  // unpublished changes, and checked at publish time so only the validated draft is published.
  draftRevision Int @default(0)

  versions WorkflowVersion[]
  runs     WorkflowRun[]
  apiKeys  WorkflowApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A key that lets external callers run one workflow's published version. The raw key
// (fm_<prefix>_<secret>) is shown once at creation and never stored: only its SHA-256 hash.
model WorkflowApiKey {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name String

  // Public lookup id embedded in the key, separate from the database id.
  prefix  String @unique
  keyHash String

  // Best effort metadata, not part of authentication.
  lastUsedAt DateTime?
  // Kept instead of deleting so past runs still point to the key that triggered them.
  revokedAt DateTime?

  createdAt DateTime @default(now())

  runs WorkflowRun[]

  @@index([workflowId])
}

// How FlowMind connects to a model provider. Canvases, versions, runs and logs only ever hold the
// credential id; the provider secret lives here, AES-256-GCM encrypted with the master key from
// CREDENTIAL_ENCRYPTION_KEY (never stored in the database). Unlike WorkflowApiKey it is encrypted,
// not hashed: the worker must recover the plaintext to call the provider.
model Credential {
  id String @id @default(cuid())

  name     String
  provider CredentialProvider
  // Null means the provider's official endpoint; required for OPENAI_COMPATIBLE (checked in the service).
  baseUrl  String?

  // base64 ciphertext, 12-byte IV (random per encryption, not secret) and 16-byte GCM auth tag.
  encryptedSecret String
  secretIv        String
  secretAuthTag   String

  // Soft delete: published versions may still reference the id, and should fail with
  // CREDENTIAL_REVOKED rather than a dangling reference.
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Immutable snapshot created by publishing. No update or delete API: runs must stay reproducible.
model WorkflowVersion {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Per-workflow sequence: 1, 2, 3...
  version Int

  canvas Json
  // Workflow.draftRevision that was published; versions created before revisions existed have 0.
  draftRevision Int

  createdAt DateTime @default(now())

  runs WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
}

model WorkflowRun {
  id String @id @default(cuid())

  // Kept alongside the version for direct history queries and for runs created before versions.
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Exactly one canvas source per run. Prisma cannot express the XOR, so the services set it and
  // the CHECK constraint "WorkflowRun_source_canvas_check" (raw SQL migration) enforces it:
  //   PUBLISHED: draftSnapshot null; workflowVersionId set by the services
  //   DRAFT:     draftSnapshot set, workflowVersionId null, workflowApiKeyId null
  // PUBLISHED may still have a null version: legacy runs from before versioning, which the worker
  // fails explicitly instead of falling back to the draft. No default: callers must choose.
  source WorkflowRunSource

  workflowVersionId String?
  workflowVersion   WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)

  // The canvas a draft test run executes, frozen at request time (may include unsaved edits).
  draftSnapshot Json?

  // Set only for runs created through the external API; null for editor runs.
  workflowApiKeyId String?
  workflowApiKey   WorkflowApiKey? @relation(fields: [workflowApiKeyId], references: [id], onDelete: SetNull)

  status RunStatus @default(PENDING)

  input  Json?
  output Json?

  errorCode    String?
  errorMessage String?

  startedAt  DateTime?
  finishedAt DateTime?
  // Refreshed by the worker while RUNNING; a stale value means the worker died mid-run.
  heartbeatAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodeRuns NodeRun[]
  logs     ExecutionLog[]

  @@index([workflowId])
  @@index([workflowVersionId])
  @@index([workflowApiKeyId])
  @@index([status])
  @@index([createdAt])
}

model NodeRun {
  id String @id @default(cuid())

  workflowRunId String
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  nodeId   String
  nodeType String

  status NodeRunStatus @default(PENDING)

  sequence  Int
  iteration Int?
  attempt   Int @default(1)

  input  Json?
  output Json?

  errorCode    String?
  errorMessage String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs ExecutionLog[]

  @@index([workflowRunId])
  @@index([workflowRunId, sequence])
  @@index([nodeId])
}

// Append-only events of a run. Run-level events (claimed, completed, recovered) have no nodeRunId.
model ExecutionLog {
  id String @id @default(cuid())

  workflowRunId String
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  nodeRunId String?
  nodeRun   NodeRun? @relation(fields: [nodeRunId], references: [id], onDelete: Cascade)

  level   ExecutionLogLevel @default(INFO)
  message String
  // IDs and codes only, never secrets, prompts or full URLs.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([workflowRunId, createdAt])
  @@index([nodeRunId, createdAt])
}
