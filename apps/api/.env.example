DATABASE_URL="postgresql://flowmind:flowmind@localhost:5432/flowmind?schema=public"

REDIS_HOST="localhost"
REDIS_PORT=6379

PORT=3000
# Used by the worker (it falls back to this file).
LLM_TIMEOUT_MS=60000

# Credential master key (AES-256-GCM), required. Shared by api and worker. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up; changing or losing it makes every stored credential undecryptable.
# Provider API keys do not go here: add them as credentials in the app (模型设置 → 模型凭证).
CREDENTIAL_ENCRYPTION_KEY=""
